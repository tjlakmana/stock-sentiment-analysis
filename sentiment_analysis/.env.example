# ============================================================
# Stock Sentiment Analysis — Environment Variable Template
# Copy to .env and fill in your values.
# ============================================================

# ----------------------------------------------------------
# Gemini API key (sentiment analysis — gemini-2.5-flash)
# Get yours at: https://aistudio.google.com/app/apikey
# ----------------------------------------------------------
GEMINI_API_KEY=YOUR_TOKEN_HERE


# ----------------------------------------------------------
# PostgreSQL connection string (async driver, asyncpg)
# Format: postgresql+asyncpg://user:password@host:port/dbname
# ----------------------------------------------------------
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/sentiment_db

# ----------------------------------------------------------
# Logging level: DEBUG | INFO | WARNING | ERROR
# ----------------------------------------------------------
LOG_LEVEL=INFO

# ----------------------------------------------------------
# Comma-separated watchlist tickers
# ----------------------------------------------------------
TICKER_WATCHLIST=AAPL,TSLA,NVDA,MSFT,AMZN,GOOGL,META,SPY,QQQ

# ----------------------------------------------------------
# RSS poll interval (minutes)
# ----------------------------------------------------------
RSS_POLL_INTERVAL_MINUTES=5

# ----------------------------------------------------------
# Finviz Elite token (real-time intraday price data)
# Requires a Finviz Elite subscription.
# ----------------------------------------------------------
FINVIZ_TOKEN=YOUR_TOKEN_HERE

# ----------------------------------------------------------
# Railway PostgreSQL URL (for local price fetcher script)
# Get from Railway → Postgres service → Connect tab → External URL
# Format: postgresql://postgres:PASSWORD@HOST:PORT/railway
# ----------------------------------------------------------
RAILWAY_DATABASE_URL=