# ============================================================
# Stock Sentiment Analysis — Environment Variable Template
# Copy to .env and fill in your values.
# ============================================================

# ----------------------------------------------------------
# Twitter / X API v2
# Get your Bearer Token from developer.twitter.com
# ----------------------------------------------------------
TWITTER_BEARER_TOKEN=
# ----------------------------------------------------------
# PostgreSQL connection string (async driver, asyncpg)
# Format: postgresql+asyncpg://user:password@host:port/dbname
# ----------------------------------------------------------
DATABASE_URL=postgresql+asyncpg://postgres:1074@localhost:5432/sentiment_db

# ----------------------------------------------------------
# Logging level: DEBUG | INFO | WARNING | ERROR
# ----------------------------------------------------------
LOG_LEVEL=INFO

# ----------------------------------------------------------
# Comma-separated watchlist tickers for Twitter search
# ----------------------------------------------------------
TICKER_WATCHLIST=AAPL,TSLA,NVDA,MSFT,AMZN,GOOGL,META,SPY,QQQ

# ----------------------------------------------------------
# Ingestion poll intervals (minutes)
# ----------------------------------------------------------
TWITTER_POLL_INTERVAL_MINUTES=2
RSS_POLL_INTERVAL_MINUTES=5
