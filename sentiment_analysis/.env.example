# ============================================================
# Stock Sentiment Analysis — Environment Variable Template
# Copy to .env and fill in your values.
# ============================================================

# ----------------------------------------------------------
# Google Gemini API key (Phase 4 sentiment analysis)
# Get yours at: https://aistudio.google.com/app/apikey
# ----------------------------------------------------------
GEMINI_API_KEY=your_gemini_api_key_here

# ----------------------------------------------------------
# PostgreSQL connection string (async driver, asyncpg)
# Format: postgresql+asyncpg://user:password@host:port/dbname
# ----------------------------------------------------------
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/sentiment_db

# ----------------------------------------------------------
# Logging level: DEBUG | INFO | WARNING | ERROR
# ----------------------------------------------------------
LOG_LEVEL=INFO

# ----------------------------------------------------------
# Comma-separated watchlist tickers
# ----------------------------------------------------------
TICKER_WATCHLIST=AAPL,TSLA,NVDA,MSFT,AMZN,GOOGL,META,SPY,QQQ

# ----------------------------------------------------------
# RSS poll interval (minutes)
# ----------------------------------------------------------
RSS_POLL_INTERVAL_MINUTES=5
