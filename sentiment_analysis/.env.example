# ============================================================
# Stock Sentiment Analysis — Environment Variable Template
# Copy this file to .env and fill in your values.
# Never commit .env to GitHub — it contains secrets!
# ============================================================

# ----------------------------------------------------------
# Google Gemini API key (sentiment analysis — gemini-2.5-flash)
# Get yours at: https://aistudio.google.com/app/apikey
# ----------------------------------------------------------
GEMINI_API_KEY=YOUR_GEMINI_API_KEY_HERE

# ----------------------------------------------------------
# PostgreSQL connection string (async driver, asyncpg)
# Format: postgresql+asyncpg://user:password@host:port/dbname
# Local example: postgresql+asyncpg://postgres:password@localhost:5432/sentiment_db
# Railway example: postgresql+asyncpg://postgres:PASSWORD@HOST.railway.internal:5432/railway
# ----------------------------------------------------------
DATABASE_URL=postgresql+asyncpg://postgres:yourpassword@localhost:5432/sentiment_db

# ----------------------------------------------------------
# Finviz Elite token (real-time intraday price data p=i1)
# Requires a Finviz Elite subscription.
# Get from: https://elite.finviz.com/api → Step 4
# ----------------------------------------------------------
FINVIZ_TOKEN=YOUR_FINVIZ_TOKEN_HERE

# ----------------------------------------------------------
# Logging level: DEBUG | INFO | WARNING | ERROR
# Default: INFO
# ----------------------------------------------------------
LOG_LEVEL=INFO

# ----------------------------------------------------------
# RSS poll interval in minutes
# Default: 5 (polls all RSS feeds every 5 minutes)
# ----------------------------------------------------------
RSS_POLL_INTERVAL_MINUTES=5
